{"v":2,"terme":"courant-jet","titre":"courant-jet","sigle":null,"slug":"courant-jet","definition":"<em>jet stream</em>. Courant d'air très rapide et étroit en haute altitude (vers 9 000 à 12 000 m), qui peut dépasser 100 kt. Il influence les performances en croisière (vent arrière ou de face) des avions en altitude. Il n'a pratiquement pas d'effet sur le vol VFR (Visual Flight Rules — vol à vue) à basse altitude, sauf par le cisaillement et la turbulence qu'il engendre.","redigee":true,"statut":"redigee","categorie":"À classer","famille":"couches_atmospheriques","famille_label":"Couches atmosphériques","famille_membres":[{"t":"atmosphère standard","titre":"atmosphère standard","sl":"atmosphere-standard","courant":false,"dev":null,"expr":null},{"t":"basses couches","titre":"basses couches","sl":"basses-couches","courant":false,"dev":null,"expr":null},{"t":"couche","titre":"couche","sl":"couche","courant":false,"dev":null,"expr":null},{"t":"courant-jet","titre":"courant-jet","sl":"courant-jet","courant":true,"dev":null,"expr":null},{"t":"densité","titre":"densité","sl":"densite","courant":false,"dev":null,"expr":null},{"t":"ISA","titre":"ISA","sl":"isa","courant":false,"dev":"International Standard Atmosphere (atmosphère standard)","expr":null},{"t":"pression","titre":"pression","sl":"pression","courant":false,"dev":null,"expr":null},{"t":"stratosphère","titre":"stratosphère","sl":"stratosphere","courant":false,"dev":null,"expr":null},{"t":"température standard","titre":"température standard","sl":"temperature-standard","courant":false,"dev":null,"expr":null},{"t":"tropopause","titre":"tropopause","sl":"tropopause","courant":false,"dev":null,"expr":null},{"t":"troposphère","titre":"troposphère","sl":"troposphere","courant":false,"dev":null,"expr":null}],"variantes":["jet stream","jet-stream","courant jet"],"variantes_dev":{},"variantes_expr":{},"sigles_expr":[],"xrefs":[{"t":"tropopause","titre":"tropopause","sl":"tropopause","dev":null,"expr":null},{"t":"cirrus","tit