{"v":2,"terme":"arcus","titre":"arcus","sigle":null,"slug":"arcus","definition":"Particularité supplémentaire de l'OMM (Organisation météorologique mondiale) : rouleau ou arc sombre à la base d'un cumulonimbus (ou d'un cumulus), précurseur d'un front de rafales. À son passage, le vent saute, des rafales arrivent et la température chute. Un arcus visible à une dizaine de kilomètres de l'aérodrome signifie qu'il vaut mieux ne ni décoller ni atterrir.","redigee":true,"statut":"redigee","categorie":"À classer","famille":"nuages_especes","famille_label":"Nuages espèces","famille_membres":[{"t":"arcus","titre":"arcus","sl":"arcus","courant":true,"dev":null,"expr":null},{"t":"asperitas","titre":"asperitas","sl":"asperitas","courant":false,"dev":null,"expr":null},{"t":"calvus","titre":"calvus","sl":"calvus","courant":false,"dev":null,"expr":null},{"t":"capillatus","titre":"capillatus","sl":"capillatus","courant":false,"dev":null,"expr":null},{"t":"castellanus","titre":"castellanus","sl":"castellanus","courant":false,"dev":null,"expr":null},{"t":"cataractagenitus","titre":"cataractagenitus","sl":"cataractagenitus","courant":false,"dev":null,"expr":null},{"t":"congestus","titre":"congestus","sl":"congestus","courant":false,"dev":null,"expr":null},{"t":"cumulus congestus","titre":"cumulus congestus","sl":"cumulus-congestus","courant":false,"dev":null,"expr":null},{"t":"fibratus","titre":"fibratus","sl":"fibratus","courant":false,"dev":null,"expr":null},{"t":"flammagenitus","titre":"flammagenitus","sl":"flammagenitus","courant":false,"dev":null,"expr":null},{"t":"floccus","titre":"floccus","sl":"floccus","courant":false,"dev":null,"expr":null},{"t":"fluctus","titre":"fluctus","sl":"fluctus","courant":false,"dev":null,"expr":null},{"t":"fractus","titre":"fractus","sl":"fractus","courant":false,"dev":null,"expr":null},{"t":"homogenitus","titre":"homogenitus","sl":"homogenitus","courant":false,"dev":null,"expr":null},{"t":"homomutatus","titre":"homomutatus","sl":"homomutatus","cou