{"v":1,"terme":"dérive (empennage)","slug":"derive-empennage","definition":"Partie fixe verticale de l'empennage, à l'arrière du fuselage. Elle assure la stabilité de route en girouette : écarté de sa trajectoire, l'avion tend à revenir dans le lit du vent relatif. Elle porte la gouverne de direction. À ne pas confondre avec la dérive du vent en navigation.","redigee":true,"statut":"redigee","categorie":"Structure & cellule","famille":"gouvernes_primaires","famille_membres":[{"t":"aileron","sl":"aileron","courant":false},{"t":"aileron au vent","sl":"aileron-au-vent","courant":false},{"t":"compensateur","sl":"compensateur","courant":false},{"t":"double commande","sl":"double-commande","courant":false},{"t":"dérive (empennage)","sl":"derive-empennage","courant":true},{"t":"effort au manche","sl":"effort-au-manche","courant":false},{"t":"empennage","sl":"empennage","courant":false},{"t":"gouverne","sl":"gouverne","courant":false},{"t":"gouverne de direction","sl":"gouverne-de-direction","courant":false},{"t":"gouverne de profondeur","sl":"gouverne-de-profondeur","courant":false},{"t":"manche","sl":"manche","courant":false},{"t":"palonnier","sl":"palonnier","courant":false},{"t":"profondeur","sl":"profondeur","courant":false},{"t":"trim","sl":"trim","courant":false}],"variantes":["dérives","empennage vertical","plan fixe vertical"],"xrefs":[{"t":"empennage","sl":"empennage"},{"t":"gouverne de direction","sl":"gouverne-de-direction"},{"t":"lacet","sl":"lacet"},{"t":"gouverne","sl":"gouverne"}],"schema":null,"schema_svg":null,"prev":{"t":"dérive","sl":"derive"},"next":{"t":"déroutement","sl":"deroutement"}}