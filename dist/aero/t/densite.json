{"v":2,"terme":"densité","titre":"densité","sigle":null,"slug":"densite","definition":"Pour l'air, masse par unité de volume (environ 1,225 kg/m³ au niveau de la mer en atmosphère standard) : elle diminue avec l'altitude et la chaleur, et elle conditionne la portance, la traction de l'hélice et la puissance d'un moteur atmosphérique. Pour le carburant, la densité (environ 0,72 kg/l pour la planification) permet de convertir litres et kilos dans le calcul de masse et centrage. Une altitude-densité élevée dégrade tout : roulement long, montée faible.","redigee":true,"statut":"redigee","categorie":"À classer","famille":"couches_atmospheriques","famille_label":"Couches atmosphériques","famille_membres":[{"t":"atmosphère standard","titre":"atmosphère standard","sl":"atmosphere-standard","courant":false,"dev":null,"expr":null},{"t":"basses couches","titre":"basses couches","sl":"basses-couches","courant":false,"dev":null,"expr":null},{"t":"couche","titre":"couche","sl":"couche","courant":false,"dev":null,"expr":null},{"t":"courant-jet","titre":"courant-jet","sl":"courant-jet","courant":false,"dev":null,"expr":null},{"t":"densité","titre":"densité","sl":"densite","courant":true,"dev":null,"expr":null},{"t":"ISA","titre":"ISA","sl":"isa","courant":false,"dev":"International Standard Atmosphere (atmosphère standard)","expr":null},{"t":"pression","titre":"pression","sl":"pression","courant":false,"dev":null,"expr":null},{"t":"stratosphère","titre":"stratosphère","sl":"stratosphere","courant":false,"dev":null,"expr":null},{"t":"température standard","titre":"température standard","sl":"temperature-standard","courant":false,"dev":null,"expr":null},{"t":"tropopause","titre":"tropopause","sl":"tropopause","courant":false,"dev":null,"expr":null},{"t":"troposphère","titre":"troposphère","sl":"troposphere","courant":false,"dev":null,"expr":null}],"variantes":["densités","masse volumique","densité de l'air","densité du carburant"],"variantes_dev":{},"variantes_expr":{},"sigles_expr":