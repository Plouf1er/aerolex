{"v":1,"terme":"gouverne de profondeur","slug":"gouverne-de-profondeur","definition":"Gouverne primaire articulée à l'arrière de l'empennage horizontal, commandée d'avant en arrière au manche. Elle modifie l'assiette longitudinale de l'avion, donc son incidence et sa vitesse. C'est la commande principale du contrôle de trajectoire dans le plan vertical.","redigee":true,"statut":"redigee","categorie":"Structure & cellule","famille":"gouvernes_primaires","famille_membres":[{"t":"aileron","sl":"aileron","courant":false},{"t":"aileron au vent","sl":"aileron-au-vent","courant":false},{"t":"compensateur","sl":"compensateur","courant":false},{"t":"double commande","sl":"double-commande","courant":false},{"t":"dérive (empennage)","sl":"derive-empennage","courant":false},{"t":"effort au manche","sl":"effort-au-manche","courant":false},{"t":"empennage","sl":"empennage","courant":false},{"t":"gouverne","sl":"gouverne","courant":false},{"t":"gouverne de direction","sl":"gouverne-de-direction","courant":false},{"t":"gouverne de profondeur","sl":"gouverne-de-profondeur","courant":true},{"t":"manche","sl":"manche","courant":false},{"t":"palonnier","sl":"palonnier","courant":false},{"t":"profondeur","sl":"profondeur","courant":false},{"t":"trim","sl":"trim","courant":false}],"variantes":["gouvernes de profondeur","profondeur","elevator"],"xrefs":[{"t":"empennage","sl":"empennage"},{"t":"tangage","sl":"tangage"},{"t":"manche","sl":"manche"},{"t":"compensateur","sl":"compensateur"}],"schema":null,"schema_svg":null,"prev":{"t":"gouverne de direction","sl":"gouverne-de-direction"},"next":{"t":"gps","sl":"gps"}}