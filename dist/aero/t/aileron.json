{"v":1,"terme":"aileron","slug":"aileron","definition":"Gouverne primaire articulée au bord de fuite de chaque aile, près de l'extrémité. Les ailerons se braquent de façon différentielle : l'un se lève quand l'autre s'abaisse, créant une différence de portance qui fait rouler l'avion autour de son axe longitudinal. Commandés au manche.","redigee":true,"statut":"redigee","categorie":"Structure & cellule","famille":"gouvernes_primaires","famille_membres":[{"t":"aileron","sl":"aileron","courant":true},{"t":"aileron au vent","sl":"aileron-au-vent","courant":false},{"t":"compensateur","sl":"compensateur","courant":false},{"t":"double commande","sl":"double-commande","courant":false},{"t":"dérive (empennage)","sl":"derive-empennage","courant":false},{"t":"effort au manche","sl":"effort-au-manche","courant":false},{"t":"empennage","sl":"empennage","courant":false},{"t":"gouverne","sl":"gouverne","courant":false},{"t":"gouverne de direction","sl":"gouverne-de-direction","courant":false},{"t":"gouverne de profondeur","sl":"gouverne-de-profondeur","courant":false},{"t":"manche","sl":"manche","courant":false},{"t":"palonnier","sl":"palonnier","courant":false},{"t":"profondeur","sl":"profondeur","courant":false},{"t":"trim","sl":"trim","courant":false}],"variantes":["ailerons"],"xrefs":[{"t":"gouverne","sl":"gouverne"},{"t":"roulis","sl":"roulis"},{"t":"manche","sl":"manche"},{"t":"aile","sl":"aile"}],"schema":null,"schema_svg":null,"prev":{"t":"aile","sl":"aile"},"next":{"t":"aileron au vent","sl":"aileron-au-vent"}}